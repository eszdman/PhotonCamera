<resources>

    <!--
      Dark-mode accent schemes. Only the primary color family is defined here;
      secondary/tertiary roles are inherited from ThemeOverlay.Photon.Accent.
      ThemeOverlay.Photon.White and ThemeOverlay.Photon.Eszdman intentionally
      keep their single fixed scheme, so they are not overridden here.
    -->

    <style name="ThemeOverlay.Photon.Default" parent="ThemeOverlay.Photon.Accent">
        <item name="colorPrimary">@color/md_deep_purple_200</item>
        <item name="colorOnPrimary">@color/md_deep_purple_900</item>
        <item name="colorPrimaryContainer">@color/md_deep_purple_700</item>
        <item name="colorOnPrimaryContainer">@color/md_deep_purple_100</item>
    </style>

