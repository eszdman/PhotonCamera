<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_hovered="true">
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
    <item android:state_activated="true" android:state_pressed="false">
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="@color/cam_on_surface"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/cam_primary"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="@color/cam_outline"/>
            <size android:width="80dp" android:height="80dp"/>
        </shape>
    </item>
</selector>
