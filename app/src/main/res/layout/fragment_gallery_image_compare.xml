<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View"/>

        <variable
                name="on_sync_click"
                type="android.view.View.OnClickListener"/>

        <variable
                name="on_share"
                type="android.view.View.OnClickListener"/>

        <variable
                name="hide_buttons"
                type="boolean"/>
    </data>

    <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

            <FrameLayout
                    android:id="@+id/image_container1"
                    tools:background="@drawable/ic_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    >
            </FrameLayout>

            <FrameLayout
                    android:id="@+id/image_container2"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    tools:background="@drawable/ic_photo"
                    android:layout_height="match_parent">
            </FrameLayout>
        </LinearLayout>

        <ToggleButton
                android:id="@+id/sync"
                android:layout_gravity="center|end"
                android:layout_marginTop="25dp"
                android:layout_marginEnd="16dp"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:checked="true"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textSize="13sp"
                android:background="@drawable/cam_chip_background"
                android:visibility='@{hide_buttons ? View.INVISIBLE : View.VISIBLE, default="visible"}'
                android:textColor="@color/cam_chip_text"
                android:textOn="@string/sync_on"
                android:textOff="@string/sync_off"
                android:onClick="@{on_sync_click}"
                />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/screen_share_button"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="bottom|end"
                app:backgroundTint="@color/cam_surface_container_high"
                app:srcCompat="@drawable/ic_share"
                app:tint="@color/cam_on_surface"
                app:elevation="0dp"
                android:visibility='@{hide_buttons ? View.INVISIBLE : View.VISIBLE, default="visible"}'
                android:onClick="@{on_share}"
                android:layout_margin="20dp"/>
    </FrameLayout>

</layout>
