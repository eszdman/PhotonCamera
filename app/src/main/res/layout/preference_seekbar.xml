<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/preference_row_min_height"
        android:paddingTop="@dimen/preference_row_vertical_padding"
        android:paddingBottom="@dimen/preference_row_vertical_padding"
        android:paddingStart="@dimen/preference_row_horizontal_padding"
        android:paddingEnd="@dimen/preference_row_horizontal_padding"
        android:baselineAligned="false">

    <ImageView
            android:id="@android:id/icon"
            android:layout_width="@dimen/preference_icon_size"
            android:layout_height="@dimen/preference_icon_size"
            android:layout_marginEnd="@dimen/preference_icon_margin"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no"
            android:contentDescription="@string/icon_string"
            tools:src="@drawable/ic_focus"/>

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <TextView
                    android:id="@android:id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:fadingEdge="horizontal"
                    tools:text="SeekBar Title"/>

            <TextView
                    android:layout_width="@dimen/preference_seekbar_value_text_width"
                    android:layout_height="wrap_content"
                    android:id="@+id/seekbar_value"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="end|center_vertical"
                    android:paddingStart="@dimen/preference_seekbar_value_padding"
                    android:paddingEnd="@dimen/preference_seekbar_value_padding"
                    tools:text="10000"/>
        </LinearLayout>

        <TextView
                android:id="@android:id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="3"
                tools:text="SeekBar description"/>

        <SeekBar
                android:id="@+id/seekbar"
                style="@style/Widget.Photon.SeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/preference_seekbar_padding"
                android:paddingBottom="@dimen/preference_seekbar_padding"/>
    </LinearLayout>

    <LinearLayout
            android:id="@android:id/widget_frame"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
</LinearLayout>
