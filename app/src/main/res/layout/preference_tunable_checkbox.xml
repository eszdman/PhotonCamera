<?xml version="1.0" encoding="utf-8"?>
<!-- Custom layout for tunable checkboxes - reduced left margin -->
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/preference_row_min_height"
        android:paddingTop="@dimen/preference_row_vertical_padding"
        android:paddingBottom="@dimen/preference_row_vertical_padding"
        android:paddingStart="@dimen/preference_row_horizontal_padding"
        android:paddingEnd="@dimen/preference_row_horizontal_padding"
        android:orientation="horizontal">

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

        <TextView
                android:id="@android:id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:maxLines="1"
                android:fadingEdge="horizontal"
                tools:text="Checkbox Title"/>

        <TextView
                android:id="@android:id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="3"
                tools:text="Checkbox description"/>
    </LinearLayout>

    <LinearLayout
            android:id="@android:id/widget_frame"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
</LinearLayout>
