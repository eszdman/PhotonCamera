<?xml version="1.0" encoding="utf-8"?><!--
    Fill colors for the morphing shutter, mirroring the old roundbutton
    selector: hovered and pressed brighten to primary, the idle (activated)
    state uses primary-container, and the disabled/processing state falls
    back to the high surface container. Accent roles follow the activity
    theme (?attr/) so accent overrides apply; the disabled default stays
    a fixed neutral surface.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_hovered="true" android:color="?attr/colorPrimary"/>
    <item android:state_activated="true" android:state_pressed="false"
          android:color="?attr/colorPrimaryContainer"/>
    <item android:state_pressed="true" android:color="?attr/colorPrimary"/>
    <item android:color="@color/cam_surface_container_high"/>
</selector>
