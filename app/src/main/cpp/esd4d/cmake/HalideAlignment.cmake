option(ESD4D_HALIDE_ALIGNMENT "Build the native ESD4D motion estimator" ON)
if(NOT ESD4D_HALIDE_ALIGNMENT)
    return()
endif()
set(align_root "${CMAKE_CURRENT_SOURCE_DIR}/../halide")
set(align_kernels alignburst_base_precise_f16 alignburst_f16_precise alignburst_base_f16
    alignburst_f16 alignburst_f16_reference alignburst_f16_global alignflow_base alignflow_f16)
if(ANDROID AND ANDROID_ABI STREQUAL "arm64-v8a")
    set(align_libs "${align_root}/arm64-v8a")
    target_include_directories(photon_esd4d PRIVATE "${align_libs}" "${align_root}/include")
    foreach(kernel IN LISTS align_kernels)
        target_link_libraries(photon_esd4d PRIVATE "${align_libs}/${kernel}.a")
    endforeach()
    target_link_libraries(photon_esd4d PRIVATE "${align_libs}/libhalide_runtime_android.a" log)
elseif(CMAKE_CROSSCOMPILING)
    message(STATUS "No packaged Halide kernels for ${CMAKE_SYSTEM_PROCESSOR}. Using the Kompute block matcher.")
    return()
else()
    # Host builds generate native kernels from the same recipes as the arm64 archives.
    find_package(Halide QUIET)
    if(NOT Halide_FOUND)
        message(STATUS "Halide SDK unavailable. Using the Kompute block matcher.")
        return()
    endif()
    add_halide_generator(esd4d_align_generator SOURCES halide/generator.cpp)
    target_include_directories(esd4d_align_generator PRIVATE "${align_root}/include")
    add_halide_runtime(esd4d_align_runtime)
    foreach(kernel IN LISTS align_kernels)
        set(generator "${kernel}")
        set(args)
        if(kernel STREQUAL "alignburst_f16_reference")
            set(generator alignburst_f16)
            set(args subpixel_mode=0)
        elseif(kernel STREQUAL "alignburst_f16_global")
            set(generator alignburst_f16)
            set(args coarse_prior=256)
        elseif(kernel STREQUAL "alignburst_f16_precise")
            set(args coarse_prior=256)
        endif()
        add_halide_library(${kernel} FROM esd4d_align_generator GENERATOR ${generator}
            USE_RUNTIME esd4d_align_runtime PARAMS ${args})
        target_link_libraries(photon_esd4d PRIVATE ${kernel})
    endforeach()
    target_include_directories(photon_esd4d PRIVATE "${align_root}/include")
endif()
target_sources(photon_esd4d PRIVATE nodes/Alignment.cpp)
target_compile_definitions(photon_esd4d PUBLIC ESD4D_HAS_PRECISE_ALIGNMENT=1)
