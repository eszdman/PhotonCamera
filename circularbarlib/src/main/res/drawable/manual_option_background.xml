<?xml version="1.0" encoding="utf-8"?>
<!-- Selected option segment: container-toned rounded rectangle behind the label
     and icon, matching the lens pill's selected lens and the shutter's tonal
     fill. Unselected is fully transparent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimaryContainer" />
            <corners android:radius="@dimen/m3_sys_shape_corner_value_large" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
