<?xml version="1.0" encoding="utf-8"?>
<!-- Black on both filled pills — the primary selection and the remembered
     control's secondary fill; white elsewhere on the bar's scrim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="#FF000000" android:state_selected="true" />
    <item android:color="#FF000000" android:state_activated="true" />
    <item android:color="@color/white" />
</selector>
